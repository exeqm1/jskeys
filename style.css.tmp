:root {
    --bg: #333333;
    --panel: #505050;
    --text: #e9eff7;
    --muted: rgba(233, 239, 247, 0.72);
    --accent: #61dafb;
    --radius: 12px;
    --shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
    --shadow-light: 0 14px 30px rgba(0, 0, 0, 0.404);
    --rojo-light: #b90504;
    --celeste-light: rgb(158, 220, 228);
    --blanquito: #e8e8e8;
    --blanquito-hover: #c0c0c0;
    --blanquito-active: #a0a0a0;
    --negrito: #252525;

}

* {
    box-sizing: border-box;
}


body {
    margin: 0;
    font-family: "Arimo", sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.container {
    width: min(1120px, 96%);
    margin: 0 auto;
}

header {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
}

.navbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 5px;
}

.brand {
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--text);
}

.brand:hover {
    transform: scale(1.05);
    transition: transform 100ms ease-in-out, color 100ms ease-in-out;
}

nav a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    transition: background 260ms ease-in-out, color 260ms ease-in-out;
}

nav a:hover {
    background: rgba(97, 218, 251, 0.18);
    color: var(--text);
}

.logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    height: 42px;
    width: auto;
}

.logo:hover {
    transform: translate(-50%, -50%) scale(1.05);
    transition: transform 150ms ease-in-out;
}

main {
    flex: 1;
    padding: 1rem 0;
    min-height: calc(100vh - 200px);
    display: flex;
    flex-direction: column;
}

.hero {
    display: grid;
    gap: 0.5rem;
    padding: 0.8rem 0;
    text-align: center;
}

.hero h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0;
}

.hero p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
}

.main-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
}

.piano-section {
    padding: 0.6rem;
    background: var(--panel);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-align: center;
}

.piano-section h2 {
    margin: 0 0 0.4rem 0;
    font-size: 0.9rem;
}

#piano {
    max-width: 600px;
    height: auto;
    width: 100%;
}

.piano-controls {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 0.6rem;
    background: var(--panel);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.micro-control {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
}

.micro-control label {
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
}

.micro-control #gain-dial {
    margin: 0 auto;
}

.controls-bottom-grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.8rem;
    align-items: start;
}

.space-placeholder {
    min-height: 120px;
}

.adsr-section {
    padding: 0.6rem !important;
    background: var(--panel);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.panel-settings {
    padding: 0.8rem;
    background: var(--panel);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 0;
}

.panel-settings h2 {
    margin: 0 0 0.6rem 0;
    font-size: 1rem;
    text-align: center;
}

.panel-settings h3 {
    margin: 0 0 0.5rem 0;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    color: var(--accent);
}

.content-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
}

.control-section {
    padding: 0.8rem;
    background: rgba(0, 0, 0, 0.3);
    border-radius: calc(var(--radius) - 4px);
    border: 1px solid rgba(97, 218, 251, 0.1);
}

